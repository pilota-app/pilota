# Lista blanca: solo se versiona lo listado. Algo nuevo en la raíz se agrega aquí (si no, queda fuera sin aviso).
/*
!/.gitignore
!/.github/
!/.claude/
!/bin/
!/ui/
!/docs/
!/herramientas/
!/pruebas/
!/app/
!/escritorio/
!/README.md
!/AGENTS.md
!/CLAUDE.md
!/GEMINI.md
!/CHANGELOG.md
!/CONTRIBUTING.md
!/CODE_OF_CONDUCT.md
!/SECURITY.md
!/LICENSE
!/build.sh
!/instalar.sh
# Pieza: la descripción de la app, las piezas que tiene y las acciones que atiende el host.
!/app.json
!/piezas.json
!/acciones.json
# La app: suma aquí sus carpetas propias de la raíz (!/plantillas/, !/ejemplos/…).
app/.build/
escritorio/node_modules/
escritorio/dist/
escritorio/vendor/
escritorio/target/
escritorio/gen/
movil/node_modules/
node_modules/
dist/
__pycache__/
.terminos-privados
capturas/
.DS_Store
